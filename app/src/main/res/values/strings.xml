    <!-- Educational footnote -->
    <string name="footnote_how_it_works" tools:ignore="PluralsCandidate">Android 13+ normally blocks apps from switching Bluetooth directly and shows a multi-step prompt. This app targets SDK %1$d for its compatibility layer while compiling against SDK %2$d, so the tile can toggle instantly.</string>

